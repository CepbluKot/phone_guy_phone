#!/bin/sh
set -eu

rules=$(mktemp)
trap 'rm -f "$rules"' EXIT
if /usr/sbin/nft list table inet voice_phone_turn >/dev/null 2>&1; then
	printf 'delete table inet voice_phone_turn\n' >> "$rules"
fi
if /usr/sbin/nft list table ip voice_phone_turn_nat >/dev/null 2>&1; then
	printf 'delete table ip voice_phone_turn_nat\n' >> "$rules"
fi
cat /etc/voice-phone/turn-firewall.nft >> "$rules"
/usr/sbin/nft -c -f "$rules"
exec /usr/sbin/nft -f "$rules"
