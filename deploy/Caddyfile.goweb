{
	auto_https disable_redirects
}

https://vm-voice-1.lan.awesomeio.ru {
	bind 192.168.20.70
	tls /etc/voice-certs/fullchain.pem /etc/voice-certs/key.pem
	handle /ws/conference {
		reverse_proxy 192.168.20.70:8080
	}
	handle /ws/live-mirror {
		reverse_proxy 192.168.20.70:8080
	}
	handle /ws/phone-signaling {
		rewrite * /ws
		reverse_proxy 127.0.0.1:8092
	}
	handle /ws/rvc-v2 {
		reverse_proxy 127.0.0.1:8090
	}
	handle /ws/rvc {
		reverse_proxy 127.0.0.1:8090
	}
	redir /call /call/ 308
	handle_path /call/* {
		root * /opt/voice-changer/web/call
		file_server
	}
	redir /live /live/ 308
	handle_path /live/* {
		root * /opt/voice-changer/web/live
		file_server
	}
	handle {
		reverse_proxy 192.168.20.70:8080
	}
}

# Research demo stack (rvc_service.rt_server on 8093 + isolated GPT v2 copy on
# 8098). Keep the separately owned research hostname unchanged across cutover.
https://voice-claude.lan.awesomeio.ru {
	bind 192.168.20.70
	tls /etc/voice-certs/fullchain.pem /etc/voice-certs/key.pem
	reverse_proxy 127.0.0.1:8093
}

# Teleport Application Service reaches this listener over loopback only. Its
# explicit path allowlist exposes the phone UI and SIP signaling route without
# publishing the passwordless admin API or any RVC/ARI routes.
http://127.0.0.1:8181 {
	@public_phone path /phone /phone/* /admin/assets/* /ws/phone-signaling
	handle @public_phone {
		reverse_proxy 192.168.20.70:8080
	}
	handle {
		respond 404
	}
}
