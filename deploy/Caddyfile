{
    auto_https disable_redirects
}
https://vm-voice-1.lan.awesomeio.ru {
    bind 192.168.20.70
    tls /etc/voice-certs/fullchain.pem /etc/voice-certs/key.pem
    handle /ws/conference {
        reverse_proxy 127.0.0.1:8091
    }
    handle /ws/call {
        reverse_proxy 127.0.0.1:8091
    }
    handle /ws/rvc-v2 {
        reverse_proxy 127.0.0.1:8090
    }
    handle /ws/rvc {
        reverse_proxy 127.0.0.1:8090
    }
    handle {
        reverse_proxy 192.168.20.70:8080
    }
}

# FCPE canary. This stays in the shared template so a future production RVC
# rollout cannot accidentally delete the private route.
https://voice-claude.lan.awesomeio.ru {
    bind 192.168.20.70
    tls /etc/voice-certs/fullchain.pem /etc/voice-certs/key.pem
    reverse_proxy 127.0.0.1:8093
}
