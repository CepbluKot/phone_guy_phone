FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd/voice-web/ cmd/voice-web/
COPY internal/admin/ internal/admin/
COPY internal/voiceconfig/ internal/voiceconfig/
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/voice-web ./cmd/voice-web

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /opt/voice-changer
COPY --from=build /out/voice-web /usr/local/bin/voice-web
COPY web/ /opt/voice-changer/web/
ENV VOICE_WEB_ROOT=/opt/voice-changer/web
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/voice-web", "healthcheck"]
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/voice-web"]
