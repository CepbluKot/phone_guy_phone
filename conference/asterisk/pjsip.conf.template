[global]
type=global

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
local_net=192.168.20.0/24
local_net=10.19.87.0/24

[phone-endpoint](!)
type=endpoint
context=phoneguy-sip
disallow=all
allow=alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
ice_support=no
; Release abandoned calls when a handset/client disappears without SIP BYE.
rtp_timeout=30

[1983](phone-endpoint)
auth=1983-auth
aors=1983
; This physical handset is receive-only in browser-to-phone mode and may use
; silence suppression. Do not tear down a valid call just because it sends no RTP.
rtp_timeout=0
[1983-auth]
type=auth
auth_type=userpass
username=1983
password=__SIP_1983_PASSWORD__
[1983]
type=aor
; Keep outbound browser calls working immediately after an Asterisk restart.
; The Yealink keeps its DHCP reservation at this address and listens on 5062.
contact=sip:1983@192.168.20.134:5062
qualify_frequency=30
max_contacts=1
remove_existing=yes

[1987](phone-endpoint)
auth=1987-auth
aors=1987
[1987-auth]
type=auth
auth_type=userpass
username=1987
password=__SIP_1987_PASSWORD__
[1987]
type=aor
max_contacts=1
remove_existing=yes

[1988](phone-endpoint)
