[global]
type=global

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
local_net=192.168.20.0/24
local_net=10.19.87.0/24

[phone-endpoint](!)
type=endpoint
context=phoneguy-sip
disallow=all
allow=alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
ice_support=no
; Release abandoned calls when a handset/client disappears without SIP BYE.
rtp_timeout=30

; Registrar matches the REGISTER To user to the AoR name. Use the extension
; for both endpoint and AoR (distinguished by type), not an '-aor' suffix.
[1983](phone-endpoint)
auth=1983-auth
aors=1983
[1983-auth]
type=auth
auth_type=userpass
username=1983
password=__SIP_1983_PASSWORD__
[1983]
type=aor
max_contacts=1
remove_existing=yes

[1987](phone-endpoint)
auth=1987-auth
aors=1987
[1987-auth]
type=auth
auth_type=userpass
username=1987
password=__SIP_1987_PASSWORD__
[1987]
type=aor
max_contacts=1
remove_existing=yes

[2014](phone-endpoint)
auth=2014-auth
aors=2014
[2014-auth]
type=auth
auth_type=userpass
username=2014
password=__SIP_2014_PASSWORD__
[2014]
type=aor
max_contacts=1
remove_existing=yes
