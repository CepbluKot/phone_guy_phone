[global]
type=global

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
local_net=192.168.20.0/24
local_net=10.19.87.0/24

; SIP over WebSocket uses Asterisk's existing HTTP /ws handler. The host
; publication for that HTTP server remains loopback-only; private Caddy
; proxies only the phone signaling path to it.
[transport-wss]
type=transport
protocol=wss
bind=0.0.0.0
external_media_address=192.168.20.70
local_net=172.19.0.0/16

; Public physical phones use end-to-end SIP TLS through the VPS. The WireGuard
; peer address is intentionally not local_net: external SDP must advertise the
; public VPS address and return RTP must follow the existing NAT state.
[transport-tls-internet]
type=transport
protocol=tls
bind=0.0.0.0:5061
method=tlsv1_2
cert_file=/run/voice-tls/current/fullchain.pem
priv_key_file=/run/voice-tls/current/key.pem
allow_reload=yes
external_signaling_address=94.102.89.13
external_signaling_port=5061
external_media_address=94.102.89.13
symmetric_transport=yes
local_net=192.168.20.0/24
local_net=172.19.0.0/16

[phone-endpoint](!)
type=endpoint
context=phoneguy-sip
disallow=all
allow=alaw
direct_media=no
media_encryption=sdes
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
ice_support=no
; Release abandoned calls when a handset/client disappears without SIP BYE.
rtp_timeout=30

[1983](phone-endpoint)
auth=1983-auth
aors=1983
; This physical handset is receive-only in browser-to-phone mode and may use
; silence suppression. Do not tear down a valid call just because it sends no RTP.
rtp_timeout=0
[1983-auth]
type=auth
auth_type=userpass
username=1983
password=__SIP_1983_PASSWORD__
[1983]
type=aor
; Keep outbound browser calls working immediately after an Asterisk restart.
; The Yealink keeps its DHCP reservation at this address and listens on 5062.
contact=sip:1983@192.168.20.134:5062
qualify_frequency=30
max_contacts=1
remove_existing=yes

[1987](phone-endpoint)
auth=1987-auth
aors=1987
[1987-auth]
type=auth
auth_type=userpass
username=1987
password=__SIP_1987_PASSWORD__
[1987]
type=aor
max_contacts=1
remove_existing=yes

[1988](phone-endpoint)
auth=1988-auth
aors=1988
[1988-auth]
type=auth
auth_type=userpass
username=1988
password=__SIP_1988_PASSWORD__
[1988]
type=aor
qualify_frequency=30
max_contacts=1
remove_existing=yes

[2014](phone-endpoint)
